{
  "apps": [
    {
      "name": "smart-agent",
      "script": "app.js",
      "instances": 1,
      "exec_mode": "fork",
      "watch": false,
      "max_memory_restart": "500M",
      "env_production": {
        "NODE_ENV": "production"
      },
      "error_file": "./data/logs/error.log",
      "out_file": "./data/logs/app.log",
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
      "merge_logs": true,
      "time": true,
      "autorestart": true,
      "max_restarts": 10,
      "min_uptime": "10s",
      "listen_timeout": 3000,
      "kill_timeout": 5000
    }
  ]
}